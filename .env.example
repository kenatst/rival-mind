# IQ ARENA - Environment Configuration
# Copy this file to .env or .env.local

# Public Supabase Client (Browser Safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode toggle: set to "true" to force local mock adapter during offline UI development
VITE_USE_MOCK_BACKEND=false

# Server-Only Configuration (NEVER expose to Vite/Browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
APP_ENV=development
API_SECRET_TOKEN=internal-secret-token-here
